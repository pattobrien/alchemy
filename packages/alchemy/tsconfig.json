{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "references": [
    { "path": "../../submodules/distilled/packages/core/tsconfig.json" },
    { "path": "../../submodules/distilled/packages/inngest/tsconfig.json" },
    { "path": "../../submodules/distilled/packages/linear/tsconfig.json" },
    {
      "path": "../alchemy-test/tsconfig.json"
    }
  ]
}
